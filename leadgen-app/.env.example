# Copy to .env.local and fill in. All of these can also be set from the
# in-app Settings page — env vars are just a convenient default for a
# fresh self-hosted deploy.

# Required: powers every reasoning stage (ICP building, scoring, briefs, etc.)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Required for account/contact research stages (lookalike accounts, signals,
# buyer roles, contact enrichment). Get one at https://app.apollo.io
APOLLO_API_KEY=

# Optional. A Clay table's "Send to Webhook" inbound URL. When set, the
# Buying Signal Finder and Contact Research Brief stages will push
# candidate accounts/contacts to this Clay table for further enrichment.
CLAY_WEBHOOK_URL=

# Optional shared secret. If set, /api/webhooks/clay requires a matching
# X-Clay-Secret header on inbound callbacks from Clay.
CLAY_INBOUND_SECRET=
